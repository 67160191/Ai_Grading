# Environment variables for the backend application
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS — กำหนด URL ของ frontend เพื่อป้องกัน CORS wildcard
# Dev: http://localhost:5173 (default ถ้าไม่ set)
# Docker local: http://localhost:8800
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# Admin account — สร้างอัตโนมัติตอน startup ถ้ายังไม่มี admin ในระบบ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme1234
ADMIN_NAME=ผู้ดูแลระบบ

# Ollama LLM API configuration
OLLAMA_URL=http://10.80.39.41:11941
OLLAMA_MODEL=qwen3-coder:30b

# File upload settings
MAX_FILE_SIZE_MB=20
MAX_FEEDBACK_LENGTH=2000
